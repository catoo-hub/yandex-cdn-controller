# Start safely. Change to false only after `cdnctl validate` and a dry-run reconcile.
DRY_RUN=true
CONFIG_PATH=/app/config.yml
DATABASE_PATH=/data/controller.db
# Внутренний пароль bot -> controller. Создать: openssl rand -hex 32
CONTROLLER_TOKEN=replace-with-a-long-random-value

# Путь внутри controller-контейнера. JSON лежит на сервере в ./secrets/.
YANDEX_AUTHORIZED_KEY_FILE=/run/secrets/yandex-authorized-key.json
# Scoped API Token с Zone:DNS:Edit только для нужной зоны.
CLOUDFLARE_API_TOKEN=
# API token панели providers.remnawave.primary.
REMNAWAVE_PRIMARY_TOKEN=

# Токен от @BotFather.
TELEGRAM_BOT_TOKEN=
# Разрешённые Telegram user ID через запятую.
TELEGRAM_ALLOWED_USER_IDS=123456789
# Chat ID для уведомлений через запятую; можно тот же личный user ID.
TELEGRAM_CHAT_IDS=123456789

# Optional integrations
UPTIME_KUMA_PUSH_URL=
GENERIC_WEBHOOK_URL=
GENERIC_WEBHOOK_SECRET=
OTEL_EXPORTER_OTLP_ENDPOINT=
